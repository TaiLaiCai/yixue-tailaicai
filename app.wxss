/* ── Reset & Base ── */
page {
  background: #09090f;
  color: #dde0f0;
  font-family: -apple-system, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.75;
}

/* ── CSS Variables via classes ── */
.bg { background: #09090f; }
.bg2 { background: #0d0e1a; }
.t1 { color: #dde0f0; }
.t2 { color: #7880a8; }
.t3 { color: #3e4062; }
.accent { color: #9aabff; }
.gold { color: #c8a882; }

/* ── Card ── */
.card {
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 24rpx;
  padding: 48rpx;
}
.card:active { border-color: rgba(180,190,240,0.14); }

/* ── Form ── */
.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.form-row .label {
  flex: 0 0 120rpx;
  font-size: 28rpx;
  color: #7880a8;
  letter-spacing: 0.05em;
}
.form-input {
  flex: 1;
  background: rgba(255,255,255,0.04);
  color: #dde0f0;
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
}

/* ── Button ── */
.gen-btn {
  width: 100%;
  margin-top: 36rpx;
  padding: 26rpx;
  background: rgba(200,168,130,0.12);
  color: #c8a882;
  border: 1rpx solid rgba(200,168,130,0.28);
  border-radius: 22rpx;
  font-size: 30rpx;
  letter-spacing: 0.4em;
  text-align: center;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gen-btn:active {
  background: rgba(200,168,130,0.22);
  border-color: rgba(200,168,130,0.5);
}

/* ── Section ── */
.section {
  margin-bottom: 60rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 400;
  color: #dde0f0;
  letter-spacing: 0.14em;
  margin-bottom: 28rpx;
  padding-left: 24rpx;
  border-left: 6rpx solid #9aabff;
}

/* ── Info Items ── */
.iitem {
  background: rgba(255,255,255,0.02);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.iitem .title {
  font-size: 28rpx;
  color: #c8a882;
  margin-bottom: 14rpx;
  font-weight: 400;
}
.iitem .desc {
  font-size: 26rpx;
  color: #7880a8;
  line-height: 1.82;
}

/* ── Grid ── */
.igrid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.igrid .iitem {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}

/* ── Tags ── */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  border: 1rpx solid;
  margin: 4rpx;
}
.tag-ji { border-color: rgba(80,190,80,0.28); color: #60c060; background: rgba(80,190,80,0.06); }
.tag-xiong { border-color: rgba(220,80,80,0.28); color: #d07070; background: rgba(220,80,80,0.06); }
.tag-zhong { border-color: rgba(154,171,255,0.28); color: #9aabff; background: rgba(154,171,255,0.12); }
.tag-bian { border-color: rgba(200,168,130,0.28); color: #c8a882; background: rgba(200,168,130,0.12); }

/* ── Hua Tags ── */
.hua { display: inline-block; font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 6rpx; margin: 2rpx; }
.hl { background: rgba(80,180,80,0.1); color: #70cc70; border: 1rpx solid rgba(80,180,80,0.2); }
.hq { background: rgba(180,140,60,0.1); color: #c89840; border: 1rpx solid rgba(180,140,60,0.2); }
.hk { background: rgba(80,130,210,0.1); color: #7298e0; border: 1rpx solid rgba(80,130,210,0.2); }
.hj { background: rgba(210,70,70,0.1); color: #d87070; border: 1rpx solid rgba(210,70,70,0.2); }

/* ── Blockquote ── */
.quote {
  border-left: 4rpx solid rgba(180,190,240,0.14);
  padding-left: 20rpx;
  margin: 20rpx 0;
  color: #3e4062;
  font-style: italic;
  font-size: 28rpx;
  line-height: 1.82;
}

/* ── Table ── */
.tbl-row {
  display: flex;
  border-bottom: 1rpx solid rgba(180,190,240,0.07);
  padding: 18rpx 0;
}
.tbl-row.header {
  background: rgba(255,255,255,0.03);
  color: #7880a8;
  font-weight: 400;
  letter-spacing: 0.06em;
}
.tbl-cell {
  flex: 1;
  padding: 0 12rpx;
  font-size: 28rpx;
  color: #7880a8;
}

/* ── WuXing Tags ── */
.wx-item {
  display: inline-block;
  padding: 6rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  border: 1rpx solid;
  margin: 4rpx;
}
.wx-mu { border-color: rgba(80,160,80,0.22); color: #70bb70; background: rgba(80,160,80,0.05); }
.wx-huo { border-color: rgba(190,90,70,0.22); color: #c87060; background: rgba(190,90,70,0.05); }
.wx-tu { border-color: rgba(170,140,70,0.22); color: #b89860; background: rgba(170,140,70,0.05); }
.wx-jin { border-color: rgba(170,170,110,0.22); color: #b0b070; background: rgba(170,170,110,0.05); }
.wx-shui { border-color: rgba(70,110,190,0.22); color: #6080c8; background: rgba(70,110,190,0.05); }

/* ── Bagua Items ── */
.bagua-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0;
}
.bagua-item {
  flex: 1 1 180rpx;
  background: rgba(255,255,255,0.02);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  text-align: center;
}
.bagua-item .sym { font-size: 56rpx; display: block; margin-bottom: 14rpx; color: #7880a8; }
.bagua-item .bname { font-size: 28rpx; color: #c8a882; }
.bagua-item .bdesc { font-size: 24rpx; color: #3e4062; margin-top: 8rpx; line-height: 1.55; }

/* ── Out Section (Divination Result) ── */
.out-sec {
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  margin-bottom: 20rpx;
}
.out-sec .sec-h3 {
  font-size: 28rpx;
  font-weight: 400;
  color: #9aabff;
  letter-spacing: 0.15em;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(180,190,240,0.07);
}
.out-row {
  display: flex;
  gap: 14rpx;
  margin: 12rpx 0;
  align-items: baseline;
}
.out-row .ol { font-size: 24rpx; color: #3e4062; flex: 0 0 110rpx; }
.out-row .ov { font-size: 28rpx; color: #dde0f0; flex: 1; }
.out-body { font-size: 28rpx; color: #7880a8; line-height: 1.92; }
.out-body .strong { color: #dde0f0; }
.out-body .em { color: #c8a882; }

/* ── Popup / Modal ── */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.65);
  z-index: 99;
}
.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #0e0f1e;
  border: 1rpx solid rgba(180,190,240,0.14);
  border-radius: 36rpx;
  padding: 48rpx;
  width: 85%;
  max-height: 80vh;
  z-index: 100;
}
.modal-close {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  color: #3e4062;
  font-size: 36rpx;
}

/* ── Sub Tabs ── */
.sub-tabs {
  display: flex;
  gap: 8rpx;
  padding: 16rpx 0;
  white-space: nowrap;
}
.sub-tab {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  border: 1rpx solid transparent;
  background: transparent;
  color: #3e4062;
  font-size: 28rpx;
  letter-spacing: 0.06em;
}
.sub-tab.active {
  color: #dde0f0;
  border-color: rgba(180,190,240,0.14);
  background: rgba(255,255,255,0.03);
}
.sub-tab.featured {
  color: #c8a882;
  border-color: rgba(200,168,130,0.25);
  background: rgba(200,168,130,0.12);
}

/* ── Yijing Box ── */
.ybox {
  background: rgba(154,171,255,0.04);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.ybox .yg { font-size: 48rpx; flex-shrink: 0; line-height: 1.2; }
.ybox .yt { font-size: 26rpx; color: rgba(154,171,255,0.72); line-height: 1.78; }

/* ── Page Padding ── */
.page-wrap {
  padding: 32rpx;
  padding-bottom: 120rpx;
  max-width: 750rpx;
  margin: 0 auto;
  box-sizing: border-box;
}

/* ── Hero Section ── */
.hero {
  text-align: center;
  padding: 48rpx 0 44rpx;
  border-bottom: 1rpx solid rgba(180,190,240,0.07);
  margin-bottom: 48rpx;
}
.hero .big-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; color: #3e4062; }
.hero .hero-title { font-size: 44rpx; font-weight: 300; color: #dde0f0; letter-spacing: 0.24em; margin-bottom: 16rpx; }
.hero .hero-desc { font-size: 28rpx; color: #7880a8; line-height: 1.75; }

/* ── Concept Grid ── */
.concept-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.concept-grid .iitem {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}

/* ── Jieju Tag ── */
.jb {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 24rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  border: 1rpx solid;
}
.jb-2 { border-color: rgba(80,140,220,0.35); color: #7898d8; }
.jb-3 { border-color: rgba(80,170,80,0.35); color: #70c070; }
.jb-4 { border-color: rgba(190,150,70,0.35); color: #c8a050; }
.jb-5 { border-color: rgba(170,130,70,0.35); color: #b89050; }
.jb-6 { border-color: rgba(210,90,70,0.35); color: #d07860; }
