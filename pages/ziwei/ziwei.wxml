<scroll-view scroll-y class="page-wrap">
  <!-- 头部 -->
  <view class="zw-hero">
    <text class="zw-icon">✦</text>
    <text class="zw-title">紫微斗数</text>
    <text class="zw-sub">中国传统命理学术体系 · 古典文化研究</text>
  </view>

  <!-- 标签 -->
  <scroll-view scroll-x class="sub-tabs-scroll">
    <view class="sub-tabs">
      <view class="sub-tab {{activeTab === 'gong' ? 'active' : ''}}" bindtap="switchTab" data-tab="gong">十二宫</view>
      <view class="sub-tab {{activeTab === 'star' ? 'active' : ''}}" bindtap="switchTab" data-tab="star">十四主星</view>
      <view class="sub-tab {{activeTab === 'sihua' ? 'active' : ''}}" bindtap="switchTab" data-tab="sihua">四化系统</view>
    </view>
  </scroll-view>

  <!-- ══ 十二宫 ══ -->
  <block wx:if="{{activeTab === 'gong'}}">
    <view class="section-intro">
      <text class="intro-text">紫微斗数以十二地支将命盘划分为十二个宫位，每宫代表人生的一个维度。研习者通过了解各宫的含义，可系统认识这一传统学术体系的结构框架。</text>
    </view>

    <view wx:for="{{gongData}}" wx:key="name" class="gong-card">
      <view class="gong-header">
        <text class="gong-num">{{item.num}}</text>
        <text class="gong-name">{{item.name}}</text>
        <text class="gong-tag">{{item.tag}}</text>
      </view>
      <text class="gong-desc">{{item.desc}}</text>
      <text class="gong-key">关键词：{{item.key}}</text>
    </view>
  </block>

  <!-- ══ 十四主星 ══ -->
  <block wx:if="{{activeTab === 'star'}}">
    <view class="section-intro">
      <text class="intro-text">紫微斗数共有十四颗主星，分属紫微系与天府系两大星系。各星具有不同的五行属性与象征特质，是学习斗数体系的核心知识点。</text>
    </view>

    <view class="star-group-title">紫微星系（六星）</view>
    <view wx:for="{{zwStars}}" wx:key="name" class="star-card">
      <view class="star-header">
        <text class="star-sym">{{item.gua}}</text>
        <view class="star-info">
          <text class="star-name">{{item.name}}</text>
          <text class="star-alias">{{item.alias}}</text>
        </view>
        <text class="star-wx star-wx-{{item.wxClass}}">{{item.wx}}</text>
      </view>
      <text class="star-desc">{{item.desc}}</text>
      <view class="star-gua-box">
        <text class="star-gua-sym">{{item.gua}}</text>
        <text class="star-gua-note">{{item.guaNote}}</text>
      </view>
    </view>

    <view class="star-group-title">天府星系（八星）</view>
    <view wx:for="{{tfStars}}" wx:key="name" class="star-card">
      <view class="star-header">
        <text class="star-sym">{{item.gua}}</text>
        <view class="star-info">
          <text class="star-name">{{item.name}}</text>
          <text class="star-alias">{{item.alias}}</text>
        </view>
        <text class="star-wx star-wx-{{item.wxClass}}">{{item.wx}}</text>
      </view>
      <text class="star-desc">{{item.desc}}</text>
      <view class="star-gua-box">
        <text class="star-gua-sym">{{item.gua}}</text>
        <text class="star-gua-note">{{item.guaNote}}</text>
      </view>
    </view>
  </block>

  <!-- ══ 四化系统 ══ -->
  <block wx:if="{{activeTab === 'sihua'}}">
    <view class="section-intro">
      <text class="intro-text">四化是紫微斗数最具特色的分析工具，由天干引动各星产生化禄、化权、化科、化忌四种变化，是理解斗数格局与星盘结构的关键。</text>
    </view>

    <view wx:for="{{sihuaData}}" wx:key="name" class="sihua-card sihua-{{item.cls}}">
      <view class="sihua-header">
        <text class="sihua-sym">{{item.sym}}</text>
        <text class="sihua-name sihua-name-{{item.cls}}">{{item.name}}</text>
        <text class="sihua-brief">{{item.brief}}</text>
      </view>
      <text class="sihua-desc">{{item.desc}}</text>
      <text class="sihua-quote">{{item.quote}}</text>
    </view>

    <view class="section">
      <text class="section-title">十天干四化对照表</text>
      <view class="tbl-row header">
        <text class="tbl-cell" style="flex:0 0 60rpx">天干</text>
        <text class="tbl-cell sihua-name-hl">化禄</text>
        <text class="tbl-cell sihua-name-hq">化权</text>
        <text class="tbl-cell sihua-name-hk">化科</text>
        <text class="tbl-cell sihua-name-hj">化忌</text>
      </view>
      <view wx:for="{{sihuaTable}}" wx:key="gan" class="tbl-row">
        <text class="tbl-cell" style="flex:0 0 60rpx;color:#c8a882">{{item.gan}}</text>
        <text class="tbl-cell sihua-name-hl">{{item.lu}}</text>
        <text class="tbl-cell sihua-name-hq">{{item.quan}}</text>
        <text class="tbl-cell sihua-name-hk">{{item.ke}}</text>
        <text class="tbl-cell sihua-name-hj">{{item.ji}}</text>
      </view>
    </view>
  </block>

  <!-- 说明 -->
  <view class="disclaimer">
    <text class="disclaimer-text">说明：本页内容依据《紫微斗数全书》《斗数宣微》等古籍文献整理，仅供传统文化学习与学术研究参考，不构成任何现实决策建议，请理性看待。</text>
  </view>
</scroll-view>
