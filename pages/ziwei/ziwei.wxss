/* 头部 */
.zw-hero { text-align: center; padding: 60rpx 0 40rpx; }
.zw-icon { display: block; font-size: 60rpx; color: #c8a882; margin-bottom: 20rpx; }
.zw-title { display: block; font-size: 52rpx; font-weight: 200; letter-spacing: 0.32em; color: #dde0f0; margin-bottom: 14rpx; }
.zw-sub { display: block; font-size: 26rpx; color: #3e4062; letter-spacing: 0.14em; }

/* 标签栏 */
.sub-tabs-scroll { white-space: nowrap; margin-bottom: 32rpx; }
.sub-tabs { display: inline-flex; padding: 0 24rpx; gap: 16rpx; }
.sub-tab {
  display: inline-block;
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #3e4062;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(180,190,240,0.07);
  letter-spacing: 0.08em;
}
.sub-tab.active { color: #c8a882; border-color: rgba(200,168,130,0.3); background: rgba(200,168,130,0.05); }

/* 简介 */
.section-intro { padding: 0 24rpx 32rpx; }
.intro-text { display: block; font-size: 26rpx; color: #7880a8; line-height: 1.9; letter-spacing: 0.04em; }

/* 十二宫卡片 */
.gong-card {
  margin: 0 24rpx 20rpx;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}
.gong-header { display: flex; align-items: center; margin-bottom: 16rpx; gap: 16rpx; }
.gong-num { font-size: 22rpx; color: #3e4062; min-width: 48rpx; }
.gong-name { font-size: 34rpx; color: #dde0f0; font-weight: 400; letter-spacing: 0.08em; }
.gong-tag { font-size: 22rpx; color: #c8a882; background: rgba(200,168,130,0.1); border-radius: 20rpx; padding: 4rpx 16rpx; margin-left: auto; }
.gong-desc { display: block; font-size: 26rpx; color: #7880a8; line-height: 1.9; margin-bottom: 10rpx; }
.gong-key { display: block; font-size: 22rpx; color: #3e4062; }

/* 主星分组标题 */
.star-group-title {
  margin: 24rpx 24rpx 16rpx;
  font-size: 26rpx;
  color: #3e4062;
  letter-spacing: 0.12em;
  padding-left: 16rpx;
  border-left: 4rpx solid rgba(200,168,130,0.3);
}

/* 主星卡片 */
.star-card {
  margin: 0 24rpx 20rpx;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}
.star-header { display: flex; align-items: center; margin-bottom: 16rpx; gap: 20rpx; }
.star-sym { font-size: 44rpx; color: #c084fc; min-width: 56rpx; }
.star-info { flex: 1; }
.star-name { display: block; font-size: 34rpx; color: #dde0f0; font-weight: 400; letter-spacing: 0.08em; }
.star-alias { display: block; font-size: 22rpx; color: #3e4062; margin-top: 4rpx; }
.star-wx { font-size: 22rpx; border-radius: 20rpx; padding: 4rpx 18rpx; }
.star-wx-mu { color: #6db56d; background: rgba(109,181,109,0.1); }
.star-wx-huo { color: #e07070; background: rgba(224,112,112,0.1); }
.star-wx-tu { color: #c8a882; background: rgba(200,168,130,0.1); }
.star-wx-jin { color: #a8c0d8; background: rgba(168,192,216,0.1); }
.star-wx-shui { color: #6898d8; background: rgba(104,152,216,0.1); }
.star-desc { display: block; font-size: 26rpx; color: #7880a8; line-height: 1.9; margin-bottom: 16rpx; }
.star-gua-box { background: rgba(255,255,255,0.02); border-radius: 12rpx; padding: 16rpx 20rpx; display: flex; align-items: flex-start; gap: 16rpx; }
.star-gua-sym { font-size: 32rpx; color: #c8a882; flex-shrink: 0; }
.star-gua-note { font-size: 22rpx; color: #3e4062; line-height: 1.8; flex: 1; }

/* 四化卡片 */
.sihua-card {
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(180,190,240,0.07);
}
.sihua-hl { background: rgba(200,168,80,0.05); border-color: rgba(200,168,80,0.2); }
.sihua-hq { background: rgba(104,152,216,0.05); border-color: rgba(104,152,216,0.2); }
.sihua-hk { background: rgba(109,181,109,0.05); border-color: rgba(109,181,109,0.2); }
.sihua-hj { background: rgba(160,80,80,0.05); border-color: rgba(160,80,80,0.2); }
.sihua-header { display: flex; align-items: center; margin-bottom: 16rpx; gap: 20rpx; }
.sihua-sym { font-size: 48rpx; font-weight: 300; color: #dde0f0; min-width: 60rpx; }
.sihua-name { font-size: 34rpx; font-weight: 400; letter-spacing: 0.08em; }
.sihua-name-hl { color: #c8a850; }
.sihua-name-hq { color: #6898d8; }
.sihua-name-hk { color: #6db56d; }
.sihua-name-hj { color: #c06060; }
.sihua-brief { font-size: 22rpx; color: #3e4062; margin-left: auto; }
.sihua-desc { display: block; font-size: 26rpx; color: #7880a8; line-height: 1.9; margin-bottom: 12rpx; }
.sihua-quote { display: block; font-size: 24rpx; color: #3e4062; line-height: 1.8; font-style: italic; }

/* 对照表 */
.section { margin: 0 24rpx 32rpx; }
.section-title { display: block; font-size: 28rpx; color: #dde0f0; letter-spacing: 0.1em; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid rgba(180,190,240,0.07); }
.tbl-row { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid rgba(180,190,240,0.04); }
.tbl-row.header { border-bottom: 1rpx solid rgba(180,190,240,0.1); }
.tbl-row.header .tbl-cell { font-size: 24rpx; color: #3e4062; }
.tbl-cell { flex: 1; font-size: 26rpx; color: #7880a8; }

/* 说明 */
.disclaimer { margin: 40rpx 24rpx 60rpx; padding: 24rpx 28rpx; background: rgba(255,255,255,0.02); border-radius: 16rpx; border: 1rpx solid rgba(180,190,240,0.05); }
.disclaimer-text { display: block; font-size: 22rpx; color: #3e4062; line-height: 1.9; }
