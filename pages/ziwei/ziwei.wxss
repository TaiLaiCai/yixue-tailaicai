.form-wrap { max-width: 600rpx; margin: 0 auto 60rpx; }
.form-title { text-align: center; margin-bottom: 48rpx; }
.form-title .title-main { display: block; font-size: 48rpx; font-weight: 200; letter-spacing: 0.32em; color: #dde0f0; margin-bottom: 14rpx; }
.form-title .title-sub { display: block; font-size: 26rpx; color: #3e4062; letter-spacing: 0.14em; }
.form-note { display: block; text-align: center; font-size: 24rpx; color: #3e4062; margin-top: 16rpx; }
.hint { font-size: 22rpx; color: #3e4062; flex-shrink: 0; }
.picker-text { min-width: 160rpx; }

/* 命盘网格 */
.chart-title { text-align: center; font-size: 28rpx; color: #7880a8; margin-bottom: 24rpx; letter-spacing: 0.16em; }

.chart-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(4, auto);
  gap: 4rpx;
  background: rgba(154,171,255,0.04);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 24rpx;
  padding: 4rpx;
  margin: 0 auto 40rpx;
  max-width: 700rpx;
}

.cell {
  background: rgba(9,9,15,0.85);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 16rpx;
  padding: 14rpx;
  min-height: 200rpx;
  position: relative;
  overflow: hidden;
}
.cell.ming { border-color: rgba(200,168,130,0.38); background: rgba(200,168,130,0.03); }

.cell-center {
  grid-column: 2 / 4;
  grid-row: 2 / 4;
  background: rgba(7,7,14,0.92);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  text-align: center;
}

.pname { font-size: 22rpx; color: #3e4062; display: block; }
.pname.ml { color: #c8a882; font-weight: 500; }
.gz { font-size: 20rpx; color: #3e4062; position: absolute; top: 8rpx; right: 12rpx; }
.shen-mk { position: absolute; top: 8rpx; right: 60rpx; font-size: 20rpx; color: rgba(140,190,140,0.6); }
.stars-wrap { margin-top: 8rpx; line-height: 1.7; }
.s { display: inline; font-size: 24rpx; color: #c8a882; }
.s.zw { color: #c084fc; }
.s.tf { color: #88b8e8; }
.s.ax-star { color: #3e4062; font-size: 20rpx; }
.dx { position: absolute; bottom: 6rpx; right: 8rpx; font-size: 20rpx; color: #3e4062; }

/* 中宫 */
.cn { font-size: 32rpx; letter-spacing: 0.1em; color: #dde0f0; margin-bottom: 16rpx; }
.cr { display: block; font-size: 24rpx; color: #7880a8; margin: 4rpx 0; }
.gold { color: #c8a882; }

/* 解读 */
.interp-section { margin-top: 40rpx; max-width: 700rpx; margin-left: auto; margin-right: auto; }
.isec {
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
}
.isec-title {
  display: block;
  font-size: 30rpx;
  color: #dde0f0;
  letter-spacing: 0.12em;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(180,190,240,0.07);
  font-weight: 400;
}
.sub-note { display: block; font-size: 22rpx; color: #3e4062; margin-top: 8rpx; }
.note { display: block; font-size: 22rpx; color: #3e4062; margin-top: 8rpx; }
.hua-wrap { margin-top: 8rpx; }

/* 弹窗 */
.popup-title { display: block; font-size: 32rpx; color: #dde0f0; margin-bottom: 20rpx; letter-spacing: 0.08em; }
.popup-daxian { display: block; font-size: 28rpx; color: #7880a8; margin-bottom: 16rpx; }
.popup-label { display: block; font-size: 28rpx; color: #7880a8; margin: 12rpx 0; }
.popup-star-desc { display: block; font-size: 26rpx; color: #c8a882; margin: 8rpx 0 8rpx 16rpx; line-height: 1.82; }
.popup-empty { display: block; font-size: 26rpx; color: #3e4062; margin: 12rpx 0; }
.popup-hua-wrap { margin: 16rpx 0; }
.popup-note {
  display: block;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(180,190,240,0.07);
  font-size: 24rpx;
  color: #3e4062;
  line-height: 1.82;
}
.strong { font-weight: 500; color: #dde0f0; }
