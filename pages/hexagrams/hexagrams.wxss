.body-text { display: block; font-size: 28rpx; color: #7880a8; line-height: 1.92; margin-bottom: 16rpx; }

/* 居中 */
.section { max-width: 700rpx; margin-left: auto; margin-right: auto; }
.hero { max-width: 700rpx; margin-left: auto; margin-right: auto; }

/* 搜索 */
.search-bar { margin-bottom: 24rpx; max-width: 700rpx; margin-left: auto; margin-right: auto; }
.search-input {
  width: 100%;
  background: rgba(255,255,255,0.04);
  color: #dde0f0;
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 分类标签 */
.cat-label {
  display: block;
  font-size: 26rpx;
  color: #3e4062;
  margin: 32rpx auto 12rpx;
  padding-left: 10rpx;
  letter-spacing: 0.06em;
  max-width: 700rpx;
}

/* 卦卡网格 - 严格两列 */
.gua-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 16rpx auto;
  max-width: 700rpx;
}

.gua-card {
  box-sizing: border-box;
  background: rgba(255,255,255,0.02);
  border: 1rpx solid rgba(180,190,240,0.07);
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  transition: border-color 0.15s, background 0.15s;
}
.gua-card.open {
  border-color: rgba(140,180,120,0.3);
  background: rgba(140,180,120,0.04);
}

.gnum { display: block; font-size: 22rpx; color: #3e4062; }
.gname { display: block; font-size: 30rpx; color: #c8a882; margin: 4rpx 0; }
.gmean { display: block; font-size: 24rpx; color: #7880a8; }
.gmsg {
  margin-top: 14rpx;
  border-top: 1rpx solid rgba(180,190,240,0.07);
  padding-top: 14rpx;
  font-size: 24rpx;
  color: rgba(140,180,140,0.78);
  line-height: 1.72;
}
